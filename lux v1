def couleur(theme, key, defaut=None):
if key in theme:
return theme[key]
return defaut or theme["fg"]


def style_inline(attrs, theme, defaut=None):
"""Convertit les attributs LUX en styles CSS inline."""
styles = []
mapping = {
"couleur": "color",
"taille": "font-size",
"poids": "font-weight",
"fond": "background",
"bord": "border",
"bord_couleur": "border-color",
"marge": "margin",
"pad": "padding",
"largeur": "width",
"hauteur": "height",
"centre": "text-align",
"radius": "border-radius",
"opacite": "opacity",
"espace": "letter-spacing",
"ligne": "line-height",
"flex": "display",
"gap": "gap",
"align": "align-items",
"justify": "justify-content",
}
for k, v in attrs.items():
if k in mapping:
css_key = mapping[k]
if css_key == "font-size" and v.isdigit():
v = v + "px"
if css_key == "text-align" and v == "oui":
v = "center"
if css_key == "display" and v == "oui":
v = "flex"
styles.append(css_key + ": " + v)
return "; ".join(styles)


def gen_html_recursive(elements, theme, ctx):
