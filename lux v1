def parse_attributs(texte):
"""Extrait les attributs key=value d'une ligne LUX."""
attrs = {}
# Pattern : key="value with spaces" ou key=value_sans_espace
pattern = re.compile(r'([a-zA-Z_][a-zA-Z0-9_\-]*)\s*=\s*(?:"([^"]*)"|\'([^\']*)\'|([^\s]+))')
for m in pattern.finditer(texte):
key = m.group(1)
val = m.group(2) if m.group(2) is not None else (m.group(3) if m.group(3) is not None else m.group(4))
attrs[key] = val
return attrs


def parse_lux(contenu):
"""
Parse un fichier LUX ligne par ligne.
Retourne une liste d'elements {niveau, primitif, valeur, attributs, enfants}.
"""
lignes = []
for ligne in contenu.split("\n"):
# Garder l'indentation pour calculer le niveau
brut = ligne.rstrip()
if not brut.strip():
continue

# Sauter les commentaires
strip = brut.strip()
if strip.startswith("#") or strip.startswith("//"):
continue

# Calculer le niveau (indentation)
indent = len(brut) - len(brut.lstrip())
niveau = indent // 2

# Extraire la premiere "primitive" et sa valeur
m = re.match(r'([a-zA-Z_][a-zA-Z0-9_\-]*)\s*(.*)', strip)
if not m:
continue

primitif = m.group(1)
reste = m.group(2)

# Extraire la valeur (ce qui est entre "..." au debut du reste)
valeur = ""
m_val = re.match(r'\s*"([^"]*)"', reste)
if m_val:
valeur = m_val.group(1)
reste = reste[m_val.end():]

# Extraire les attributs du reste
attrs = parse_attributs(reste)

lignes.append({
"niveau": niveau,
"primitif": primitif,
"valeur": valeur,
"attributs": attrs,
})

# Construire l'arbre
racine = {"niveau": -1, "primitif": "_root", "valeur": "", "attributs": {}, "enfants": []}
pile = [racine]

for el in lignes:
el["enfants"] = []
while pile and pile[-1]["niveau"] >= el["niveau"]:
pile.pop()
if pile:
pile[-1]["enfants"].append(el)
pile.append(el)

return racine["enfants"]


