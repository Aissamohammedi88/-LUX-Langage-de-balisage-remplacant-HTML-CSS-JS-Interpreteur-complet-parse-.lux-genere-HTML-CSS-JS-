if "theme" in attrs and attrs["theme"] in THEMES:
ctx["theme_actif"] = attrs["theme"]
html_parts.extend(gen_html_recursive(enfants, theme, ctx))

# ── section ──
elif primitif == "section":
s = "display: flex; flex-direction: column; gap: 12px; padding: 20px;"
