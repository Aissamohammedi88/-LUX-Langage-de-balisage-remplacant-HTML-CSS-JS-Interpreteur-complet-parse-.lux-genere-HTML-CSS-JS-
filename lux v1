def compiler_lux(contenu):
"""Compile un fichier LUX en HTML complet."""
elements = parse_lux(contenu)

# Theme par defaut
theme_nom = "sombre"
ctx = {
"titre": "LUX Page",
"theme_actif": theme_nom,
"scripts": [],
}

# Chercher le theme dans le premier element page
for el in elements:
if el["primitif"] == "page" and "theme" in el["attributs"]:
if el["attributs"]["theme"] in THEMES:
ctx["theme_actif"] = el["attributs"]["theme"]
break

theme = THEMES.get(ctx["theme_actif"], THEMES["sombre"])

# Generer le corps
corps = gen_html_recursive(elements, theme, ctx)

# HTML final
return """<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>""" + html_lib.escape(ctx["titre"]) + """</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
background: """ + theme["bg"] + """;
color: """ + theme["fg"] + """;
font-family: -apple-system, system-ui, sans-serif;
min-height: 100vh;
padding: 20px;
line-height: 1.5;
}
.lux-container { max-width: 900px; margin: 0 auto; }
button:hover { transform: translateY(-2px); opacity: 0.9; }
input:focus, select:focus { border-color: """ + theme["accent"] + """ !important; }
</style>
</head>
<body>
<div class="lux-container">
""" + "\n".join(corps) + """
</div>
<script>
""" + "\n".join(ctx["scripts"]) + """
</script>
</body>
</html>"""


